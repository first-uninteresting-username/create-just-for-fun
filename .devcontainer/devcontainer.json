{
  "name": "Create: Just for Fun developement",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu@sha256:91eff046d5c12318fc98e59258982b87ba896c467427ed8b5dab5a02107a5db7",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    }
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/workspaces/create-just-for-fun/.devcontainer/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "WakaTime.vscode-wakatime",
